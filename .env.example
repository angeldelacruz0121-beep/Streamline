# Required. SEC EDGAR returns HTTP 403 to any request without a descriptive
# User-Agent containing a real contact email, and Invariant 4.6 requires that
# header on every request. There is no default and no fallback: with this unset,
# constructing the EDGAR client throws and the proxy refuses to start.
#
# Copy this file to .env and fill in a monitored address. .env is gitignored;
# no address is ever committed to this repository.
SEC_CONTACT_EMAIL=

# Optional. Proxy bind address and response cache location.
# PORT=8787
# HOST=127.0.0.1
# EDGAR_CACHE_DIR=.cache/edgar
